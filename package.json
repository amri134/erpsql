{
  "name": "erp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend awal ERP dengan Express, TypeScript, dan SQL Server.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc",
    "build:web": "vite build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "npm run build:server && node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm run typecheck:web && npm test && npm run build:web",
    "db:migrate": "tsx src/scripts/migrate.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.7.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^11.0.1",
    "pdfkit": "^0.20.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
